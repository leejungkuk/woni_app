<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Supabase OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>woniapp</string>
			</array>
		</dict>
	</array>
	<!-- 앱이 지원한다고 선언하는 언어. iOS는 Locale.current를 「기기 선호 언어 ∩ 앱 지원 언어」로
	     계산하므로, 이 선언이 en 하나면 한국어 기기에서도 ko가 나올 수 없어 첫 진입이 늘 영어가 된다.
	     문자열은 .lproj가 아니라 WoniStrings가 코드로 갖고 있어 지원 언어 선언만 있으면 된다.
	     INFOPLIST_KEY_CFBundleLocalizations 는 커스텀 plist에 병합되지 않아(빌드로 확인) 여기 직접 둔다. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
	</array>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<!-- 개발(Debug) 빌드 전용: 시뮬레이터에서 http://localhost:8080 평문 접근 허용.
	     GENERATE_INFOPLIST_FILE=YES가 나머지 표준 키를 이 plist 위에 병합한다. Release에는 적용되지 않는다. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
