<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Supabase OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>woniapp</string>
			</array>
		</dict>
	</array>
	<!-- Release 빌드 전용 커스텀 Info.plist 부분본. GENERATE_INFOPLIST_FILE=YES가 표준 키를
	     이 위에 병합한다. INFOPLIST_KEY_ 프리픽스는 커스텀(비-Apple) 키를 합성하지 않으므로,
	     SUPABASE_URL/ANON_KEY/API_BASE_URL은 커스텀 plist 엔트리로 두고 xcconfig 변수로
	     주입한다 (값 공급: Config/Release.xcconfig → Shared.xcconfig + 선택적
	     Config/Secrets.Release.xcconfig). -->
	<!-- 앱이 지원한다고 선언하는 언어. iOS는 Locale.current를 「기기 선호 언어 ∩ 앱 지원 언어」로
	     계산하므로, 이 선언이 en 하나면 한국어 기기에서도 ko가 나올 수 없어 첫 진입이 늘 영어가 된다.
	     문자열은 .lproj가 아니라 WoniStrings가 코드로 갖고 있어 지원 언어 선언만 있으면 된다. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
	</array>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
</dict>
</plist>
