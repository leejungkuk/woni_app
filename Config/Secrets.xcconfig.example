// 구성별 시크릿 템플릿. 둘 다 gitignore된다.
//   개발: 이 파일을 Config/Secrets.xcconfig 로 복사 (Debug.xcconfig 가 include)
//   운영: 이 파일을 Config/Secrets.Release.xcconfig 로 복사 (Release.xcconfig 가 include)
//
// xcconfig 에서 `//` 는 주석이므로 URL 의 이중 슬래시는 `$()` 로 끊어야 한다.
// 빠뜨리면 값이 스킴까지만 남아 잘리고, 앱은 조용히 seed 데이터로 폴백한다.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

// 백엔드 베이스 URL. Debug 는 Debug.xcconfig 가 http:/$()/localhost:8080 을 기본값으로 주므로,
// 실기기 테스트로 LAN IP 를 쓸 때만 아래 줄로 덮어쓰면 된다. Release 는 기본값이 없다.
// API_BASE_URL = http:/$()/192.168.0.1:8080
