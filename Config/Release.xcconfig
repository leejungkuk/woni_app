// 운영 빌드 설정 (Xcode Release 구성의 baseConfigurationReference).
#include "Shared.xcconfig"

// 운영 값은 gitignore된 이 파일에서만 온다 — 커밋되는 파일에 운영 설정을 두지 않는다.
// 파일이 없으면 Shared.xcconfig의 빈 기본값으로 빌드되고, SupabaseConfig.load()가 실행
// 시점에 SupabaseConfigError를 던진다.
//
// verify.sh는 Debug만 탄다. CI는 Release 스모크 빌드 단계로 이 파일 체인을 파싱한다.
#include? "Secrets.Release.xcconfig"
